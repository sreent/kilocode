{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@enterprise/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted enterprise control plane: SSO, SCIM, org policy, audit logs and usage analytics",
  "exports": {
    ".": "./src/app.ts"
  },
  "bin": {
    "enterprise-server": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts serve",
    "start": "bun run src/index.ts serve",
    "bootstrap": "bun run src/index.ts bootstrap",
    "build": "bun build --compile --minify --no-compile-autoload-bunfig src/index.ts --outfile dist/enterprise-server",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "test:ci": "mkdir -p .artifacts/unit && bun test --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "hono": "catalog:",
    "jose": "6.2.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
