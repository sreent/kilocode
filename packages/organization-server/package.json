{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@organization/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted organization server: SSO, SCIM, org policy, audit logs and usage analytics",
  "exports": {
    "./*": "./src/*.ts"
  },
  "bin": {
    "organization-server": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts serve",
    "start": "bun run src/index.ts serve",
    "bootstrap": "bun run src/index.ts bootstrap",
    "build": "bun run script/build.ts",
    "migration": "bun run script/migration.ts",
    "db": "bun drizzle-kit",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "test:ci": "mkdir -p .artifacts/unit && bun test --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.0-beta.83",
    "@electric-sql/pglite": "0.5.9",
    "@organization/protocol": "workspace:*",
    "@node-saml/node-saml": "5.1.0",
    "@opencode-ai/core": "workspace:*",
    "@xmldom/xmldom": "0.8.15",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "xml-crypto": "6.4.0"
  }
}
